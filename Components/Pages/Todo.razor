@page "/todo"
@rendermode InteractiveServer
@using ToDoApp.Model
@using ToDoApp.Repository
@inject ToDoItemRepository ToDoRepo //Db verbindung(Variable)
@inject IJSRuntime JS 

<PageTitle>ToDoApp</PageTitle>

<div class="wrapper">
    <h1>My ToDo's</h1>
    <h3>left over Tasks: @items.Count</h3>

    @*ToDo EingabeFormular + Liste*@
    <div class="todo-form">

        @*Create Methode------------------------------------------------------------------*@
        @*bind:event="oninput" // Jeder Tastendruck löst direkt aus --> new Task aktualisierenen*@
        <input type="text" @bind="newTask" @bind:event="oninput" @onkeydown="CreateEnterKey" placeholder="Whats your ToDo..." />  
        <button class="add-btn" @onclick="CreateTask"> Add </button>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="error-message">@errorMessage</p>    
        }

        @*GetAll Function-----------------------------------------------------------------*@
        <ul class="todo-list"> 
            @foreach (var item in items)
            {
                <li class="todo-item">
                @*Update Function---------------------------------------------------------*@
                @if (item.Id == editingId)   
                {
                        <input class="edit-input" @bind="editedTitle" @bind:event="oninput" @onkeydown="@(e => SaveEnterKey(e, item.Id))" />
                        <button class="save-btn" @onclick="@(() => SaveTask(item.Id, editedTitle))">Save</button> //wegen if schleife erwartet razor C# Code.
                } 
                else
                {
                    <span>@item.Title</span>
                    <button class="update-btn" @onclick="@(() => UpdateTask(item.Id))">Update</button>  
                }

                @*Delete Function---------------------------------------------------------*@
                    <button class="delete-btn" @onclick="() => DeleteTask(item.Id)">Delete</button>
                </li>
            }
        </ul>

    </div>
</div>

@code {
    // GetAll -----------------------------------------------------------------------------
    private List<ToDoItem> items = new();
    protected override void OnInitialized()  // Start der app Automatisch überschreiben 
    {
        items = ToDoRepo.GetAll().ToList();

    }

    //Create ------------------------------------------------------------------------------
    string newTask;
    string errorMessage;
    protected async Task CreateTask()
    {
        if (string.IsNullOrWhiteSpace(newTask))
        {
            errorMessage = "Task must not be empth!";
            return;
        }

        errorMessage = "";
        ToDoItem newItem = new ToDoItem();
        newItem.Title = newTask;
        ToDoRepo.Create(newItem);  
        items = ToDoRepo.GetAll().ToList();
        newTask = "";
    }

    // Function for Enter Key: Creates a task like the button
    protected async Task CreateEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await CreateTask();
        }
    }

    //Delete -------------------------------------------------------------------------------
    protected void DeleteTask(int id)
    {
        ToDoRepo.Delete(id);
        items = ToDoRepo.GetAll().ToList();  // Liste neu Laden
    }

    //Update -------------------------------------------------------------------------------
    int? editingId = null;
    private String editedTitle;

    protected void SaveTask(int id, string title)
    {
        ToDoRepo.Update(id, title);
        items = ToDoRepo.GetAll().ToList();
        editingId = null;
        editedTitle = "";
    }

    protected void UpdateTask(int id)
    {
        editingId = id;
        editedTitle = items.FirstOrDefault(i => i.Id == id)?.Title ?? "";
    }

    // fuction for Enter Key: Saves the update like the Save-Button
    protected void SaveEnterKey(KeyboardEventArgs e, int id)
    {
        if(e.Key == "Enter")
        {
            SaveTask(id, editedTitle); 
        }    
    }
}   