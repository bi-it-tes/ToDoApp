@page "/todo"
@rendermode InteractiveServer
@using ToDoApp.Model

@*TodoListe Tutorial: https://www.youtube.com/watch?v=nJzgPOQF3tU&t=106s*@

<PageTitle>ToDo-App</PageTitle>

<h1>My ToDo's</h1>
<h3>left over Tasks: (@toDos.Count(toDo => !toDo.IsDone))</h3>

<div class="App-Container">

<form>
        <input type="text" id="task-input" placeholder="Whats your task..." @bind="newToDo" />
        <button type="button" id="submit-btn" @onclick="AddToDo">Add Task</button>
</form>

<div class="todos-containers">
    <ul id="task-list">

        @foreach (var toDo in toDos)
        {
            <li>
                    <input type="checkbox" @bind="toDo.IsDone" />
                    <input type="text" @bind="toDo.Title">
                    <button type="button" id="delete-btn" @onclick="() => toDos.Remove(toDo)">Delete</button>
            </li>
        }
    </ul>
</div>
</div>

@code {
    private IList<ToDoItem> toDos = new List<ToDoItem>();
    private string newToDo;
    private void AddToDo()
    {
        if (!string.IsNullOrEmpty(newToDo))
        {
            toDos.Add(new ToDoItem()
            {
               Title=newToDo 
            });
            newToDo = string.Empty;
        }
    }
    private void DeleteToDo()
    {
        if (toDos.Count > 0)
        {
            toDos.RemoveAt(toDos.Count - 1);
        }
    }
}
