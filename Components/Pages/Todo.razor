@page "/todo"
@rendermode InteractiveServer

<PageTitle>ToDo-App</PageTitle>

<h1>My ToDo's</h1>

<form>
    <div class="mb-3">
        
        <label for="todo" class="form-label">Add a new ToDo</label>
        <input type="text" class="form-control" id="todo" placeholder="Enter a new ToDo" />

    </div>
    
    <button type="submit" class="btn btn-primary">Add ToDo</button>
</form>

